#!/bin/bash
set -e

echo "Container is starting..." 1>&2

if ! [ "$DISABLE_NPM_CI" = "true" ]
then
  echo "[TaskStart][Init] npm ci" 1>&2
  npm ci
  echo "[TaskEnd][Init] npm ci" 1>&2
else
  echo "[TaskSkip][Init] npm ci" 1>&2
fi

# Start the single Node server (serves the front via HMR + proxies the Docker
# API + hosts the exec bridge). Config is served dynamically from env, so there
# is no more `make config` step.
echo "[Service][Start] Starting heimdall server (dev)" 1>&2
exec npm run dev
